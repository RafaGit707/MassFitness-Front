<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@color/massfitness_background_2">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginRight="20dp">

        <TextView
            android:id="@+id/txtNombreClase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre del Logro"
            android:textColor="@color/massfitness"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvLogroDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Descripcion del Logro"
            android:textSize="15sp"
            android:textColor="@color/darker_grey" />

        <TextView
            android:id="@+id/tvLogroStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/darker_grey" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnEditarClase"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/icon_user_purple"
        android:transitionName="userImageTrans" />

    <ImageView
        android:id="@+id/btnEliminarClase"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_alignEnd="@id/addClase"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_notification_off"
        android:transitionName="userImageTrans" />

</LinearLayout>