<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/massfitness_background_2">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginRight="40dp">

        <TextView
            android:id="@+id/tvNombreClase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre de la Clase"
            android:textColor="@color/massfitness"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvNombreDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Descripcion de la Clase"
            android:textSize="15sp"
            android:textColor="@color/darker_grey" />

        <TextView
            android:id="@+id/tvNombreEntrenador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Entrenador"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/darker_grey" />

        <TextView
            android:id="@+id/tvCapacidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50 personas"
            android:textSize="16sp"
            android:textColor="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/btnEditarClase"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="40dp"
            android:src="@drawable/ic_delete"/>

        <ImageView
            android:id="@+id/btnEliminarClase"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"/>
    </LinearLayout>

</LinearLayout>